enum PayoutKind {
  PARTNER
  ADMIN
}

enum PayoutStatus {
  PENDING_APPROVAL
  APPROVED
  PAID
  SETTLED
  REJECTED
}

enum RemittanceMethod {
  CASH_DEPOSIT
  UPI
  BANK_TRANSFER
}

enum AdjustmentKind {
  BONUS
  DEDUCTION
}

enum ChangeRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model AdminAccount {
  id                String   @id @default(cuid())
  workspaceId       String
  name              String
  location          String
  accountCode       String
  monthlySalary     Decimal  @default(0) @db.Decimal(12, 2)
  commissionPercent Decimal  @default(0) @db.Decimal(5, 2)
  incentiveAmount   Decimal  @default(0) @db.Decimal(12, 2)
  onTimeThreshold   Decimal  @default(90) @db.Decimal(5, 2)
  createdAt         DateTime @default(now())

  workspace      Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  partners       DeliveryPartner[]
  payouts        Payout[]
  adjustments    PayAdjustment[]
  changeRequests PayChangeRequest[]

  @@unique([workspaceId, accountCode])
  @@index([workspaceId])
}

model PartnerRemittance {
  id          String           @id @default(cuid())
  workspaceId String
  partnerId   String
  amount      Decimal          @db.Decimal(12, 2)
  method      RemittanceMethod
  note        String?
  remittedAt  DateTime         @default(now())

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  partner   DeliveryPartner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([workspaceId, remittedAt])
  @@index([partnerId])
}

model PayAdjustment {
  id          String         @id @default(cuid())
  workspaceId String
  partnerId   String?
  adminId     String?
  kind        AdjustmentKind
  amount      Decimal        @db.Decimal(12, 2)
  note        String
  createdAt   DateTime       @default(now())

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  partner   DeliveryPartner? @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  admin     AdminAccount?    @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
}

model Payout {
  id          String       @id @default(cuid())
  workspaceId String
  code        String
  kind        PayoutKind
  partnerId   String?
  adminId     String?
  cycle       String
  amount      Decimal      @db.Decimal(12, 2)
  dueDate     DateTime
  status      PayoutStatus @default(PENDING_APPROVAL)
  note        String       @default("System · auto settlement")
  generatedAt DateTime     @default(now())
  approvedAt  DateTime?
  approvedBy  String?
  paidAt      DateTime?

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  partner   DeliveryPartner? @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  admin     AdminAccount?    @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, code])
  @@index([workspaceId, cycle])
  @@index([workspaceId, status])
}

model PayChangeRequest {
  id                    String              @id @default(cuid())
  workspaceId           String
  code                  String
  partnerId             String
  requestedById         String
  proposedMonthlySalary Decimal             @default(0) @db.Decimal(12, 2)
  proposedFixedPay      Decimal             @default(0) @db.Decimal(12, 2)
  proposedPerDelivery   Decimal             @default(0) @db.Decimal(12, 2)
  proposedFeeShare      Decimal             @default(0) @db.Decimal(5, 2)
  reason                String
  status                ChangeRequestStatus @default(PENDING)
  createdAt             DateTime            @default(now())
  decidedAt             DateTime?

  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  partner     DeliveryPartner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  requestedBy AdminAccount    @relation(fields: [requestedById], references: [id], onDelete: Cascade)

  @@unique([workspaceId, code])
  @@index([workspaceId, status])
}

model FinanceAuditLog {
  id          String   @id @default(cuid())
  workspaceId String?
  actor       String
  action      String
  detail      String
  createdAt   DateTime @default(now())

  @@index([createdAt])
}
