// Owner: Dev 2 (operations). Orders move only through the state machine in
// packages/shared/src/orders/status.ts, with a `version` check on each change.

enum OrderStatus {
  placed
  accepted
  preparing
  packed
  ready
  assigned
  picked_up
  out_for_delivery
  delivered
  cancelled
  refund_requested
  refunded
}

enum PaymentMethod {
  upi
  card
  cod
  wallet
  netbanking
}

enum PaymentStatus {
  pending
  paid
  failed
  refunded
}

model Order {
  id               String        @id @default(cuid())
  code             String        @unique
  business         Business
  status           OrderStatus   @default(placed)
  version          Int           @default(0)
  customerName     String
  customerPhone    String
  vendorId         String
  partnerId        String?
  deliveryFleetId  String?
  deliveryBoyId    String?
  zoneId           String
  paymentMethod    PaymentMethod
  paymentStatus    PaymentStatus @default(pending)
  itemsTotalPaise  Int
  deliveryFeePaise Int
  /// Hashed 4-digit code the customer gives the rider at the door. Never stored in clear.
  deliveryOtpHash  String?
  otpVerifiedAt    DateTime?
  /// Photo of the delivered order, stored in object storage.
  proofKey         String?
  proofContentType String?
  proofAt          DateTime?
  totalPaise       Int
  placedAt         DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  vendor              Vendor               @relation(fields: [vendorId], references: [id])
  partner             Partner?             @relation(fields: [partnerId], references: [id])
  deliveryFleet       DeliveryFleet?       @relation(fields: [deliveryFleetId], references: [id])
  deliveryBoy         DeliveryBoy?         @relation(fields: [deliveryBoyId], references: [id])
  zone                Zone                 @relation(fields: [zoneId], references: [id])
  items               OrderItem[]
  events              OrderEvent[]
  deliveryAssignments DeliveryAssignment[]
  deliveryOffers      DeliveryOffer[]

  @@index([business, status])
  @@index([zoneId, placedAt])
  @@map("orders")
}

model DeliveryAssignment {
  id           String                   @id @default(cuid())
  orderId      String
  fleetId      String
  boyId        String
  assignedById String?
  status       DeliveryAssignmentStatus @default(assigned)
  assignedAt   DateTime                 @default(now())
  endedAt      DateTime?
  reason       String?
  order        Order                    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  fleet        DeliveryFleet            @relation(fields: [fleetId], references: [id], onDelete: Restrict)
  boy          DeliveryBoy              @relation(fields: [boyId], references: [id], onDelete: Restrict)

  @@index([orderId, assignedAt])
  @@index([boyId, status, endedAt])
  @@index([fleetId, assignedAt])
  @@map("delivery_assignments")
}

model OrderItem {
  id             String @id @default(cuid())
  orderId        String
  name           String
  quantity       Int
  unitPricePaise Int
  order          Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_items")
}

model OrderEvent {
  id        String       @id @default(cuid())
  orderId   String
  from      OrderStatus?
  to        OrderStatus
  /// member, system or app (customer / vendor / partner app via intake)
  actorType String
  actorId   String?
  reason    String?
  at        DateTime     @default(now())
  order     Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, at])
  @@map("order_events")
}

enum OfferStatus {
  offered
  accepted
  declined
  expired
  withdrawn
}

/// An order offered to one rider. The rider has a short time to accept or decline; otherwise the
/// next suitable rider is offered the order.
model DeliveryOffer {
  id            String       @id @default(cuid())
  orderId       String
  boyId         String
  fleetId       String
  status        OfferStatus  @default(offered)
  offeredAt     DateTime     @default(now())
  expiresAt     DateTime
  respondedAt   DateTime?
  declineReason String?
  order         Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  boy           DeliveryBoy  @relation(fields: [boyId], references: [id], onDelete: Cascade)

  @@index([orderId, status])
  @@index([boyId, status])
  @@index([status, expiresAt])
  @@map("delivery_offers")
}
