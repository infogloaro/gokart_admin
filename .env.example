# Copy to apps/api/.env and adjust. Never commit real values.
NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:3000

DATABASE_URL=postgresql://gokart:gokart@localhost:5434/gokart
REDIS_URL=redis://localhost:6380

# Session cookie signing secret: any long random string
SESSION_SECRET=change-me-to-a-long-random-string

# Mailpit locally (inbox at http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM="GoKart Admin <no-reply@gokart.local>"

# MinIO locally (console at http://localhost:9001)
S3_ENDPOINT=http://localhost:9000
S3_REGION=ap-south-1
S3_BUCKET=gokart-dev
S3_ACCESS_KEY=gokart
S3_SECRET_KEY=gokart-minio
