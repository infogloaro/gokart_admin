# Copy to apps/api/.env and adjust. Never commit real values.
NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:3000

DATABASE_URL=postgresql://gokart:gokart@localhost:5433/gokart
REDIS_URL=redis://localhost:6379

# Session cookie signing secret: any long random string
SESSION_SECRET=change-me-to-a-long-random-string

# Mailpit locally (inbox at http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM="GoKart Admin <no-reply@gokart.local>"

# SMS sign-in codes. "dev" puts them in Mailpit; "msg91" sends real SMS once the
# DLT-approved template (containing ##otp##) is ready.
SMS_PROVIDER=dev
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# Encrypts authenticator-app secrets. Required in production: `openssl rand -base64 32`.
# Locally it can stay empty (a key derived from SESSION_SECRET is used).
TOTP_ENCRYPTION_KEY=

# Document storage: "s3" uses the S3 settings below (MinIO from `pnpm services:up` locally,
# console at http://localhost:9001). "local" keeps files in apps/api/.storage instead.
STORAGE_DRIVER=s3
# S3 / MinIO
S3_ENDPOINT=http://localhost:9000
S3_REGION=ap-south-1
S3_BUCKET=gokart-dev
S3_ACCESS_KEY=gokart
S3_SECRET_KEY=gokart-minio

# Partner app intake (x-intake-key header). Development falls back to a fixed key.
INTAKE_KEY=
